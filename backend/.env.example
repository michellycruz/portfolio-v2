# Porta do servidor HTTP
PORT=8080

# Origem permitida para CORS (URL do frontend em produção)
FRONTEND_ORIGIN=http://localhost:5173

# Pasta com o build estático do frontend (frontend/dist) para servir tudo
# a partir de um único binário Go em produção. Deixe em branco em dev.
STATIC_DIR=

# SMTP para o formulário de contato (ex.: smtp.gmail.com com senha de app).
# Se deixar em branco, as mensagens só são logadas no console (modo dev).
# Atenção: em deploy (STATIC_DIR preenchido ou APP_ENV=production) o servidor
# se recusa a subir com qualquer um destes em branco, porque o formulário
# confirmaria ao visitante mensagens que nunca seriam enviadas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Marca o ambiente como produção mesmo sem STATIC_DIR (exige SMTP completo).
APP_ENV=

# Escape: sobe um deploy sem SMTP de propósito, aceitando o modo só-log.
ALLOW_UNCONFIGURED_SMTP=
